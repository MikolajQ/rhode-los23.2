<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest dla rhode (Moto G52) na bazie manifestu Tomoms 16.2.
  Kopiowany do .repo/local_manifests/ przez ham.yml.
  Remote "github" (fetch="..") rozwiązuje się do https://github.com/ .
-->
<manifest>
  <remote name="gitlab" fetch="https://gitlab.com/" />

  <!-- urządzenie: drzewa Tomoms na 16.2, kernel z własnego forka (KernelSU-Next) -->
  <project path="device/motorola/rhode"         name="Tomoms/android_device_motorola_rhode"          remote="github" revision="16.2" />
  <project path="device/motorola/sm6225-common" name="Tomoms/android_device_motorola_sm6225-common"  remote="github" revision="16.2" />
  <project path="kernel/motorola/sm6225"        name="MikolajQ/android_kernel_motorola_sm6225"       remote="github" revision="16.2-ksun" />
  <project path="hardware/motorola"             name="LineageOS/android_hardware_motorola"          remote="github" revision="lineage-23.2" />
  <project path="hardware/samsung_slsi/nfc"     name="LineageOS/android_hardware_samsung_slsi_nfc"  remote="github" revision="lineage-23.2" />

  <!-- bloby: radio/* na git-lfs, stąd flaga git-lfs przy repo init -->
  <project path="vendor/motorola/rhode"         name="TheMuppets/proprietary_vendor_motorola_rhode"          remote="github" revision="lineage-23.2" />
  <project path="vendor/motorola/sm6225-common" name="TheMuppets/proprietary_vendor_motorola_sm6225-common"  remote="github" revision="lineage-23.2" />

  <!-- własny vendor/extra: OTA, additional_repos.xml, manager KSU-Next, gapps-extras -->
  <project path="vendor/extra"                  name="MikolajQ/android_vendor_extra"                remote="github" revision="rhode" />

  <!-- GApps: MindTheGapps prosto z GitLaba (GmsCore/Velvet na LFS); cięcia listy pakietów -> patches/vendor_gapps -->
  <project path="vendor/gapps"                  name="MindTheGapps/vendor_gapps"                    remote="gitlab" revision="baklava" clone-depth="1" />

  <!-- F-Droid (prebuilt) + privileged extension -->
  <project path="external/F-Droid"                         name="Tomoms/android_external_F-Droid" remote="github" revision="master" clone-depth="1" />
  <project path="packages/apps/F-DroidPrivilegedExtension" name="fdroid/privileged-extension"    remote="gitlab" revision="master" clone-depth="1" />

  <!-- WebView: Cromite/AOSmium (Tomoms) zamiast prebuiltu LineageOS -->
  <remove-project name="LineageOS/android_external_chromium-webview_patches" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_arm" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_arm64" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86_64" />
  <project path="external/chromium-webview" name="Tomoms/android_external_chromium-webview" remote="github" revision="master" clone-depth="1" />
</manifest>
