<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest dla rhode (Moto G52) na bazie manifestu LineageOS lineage-23.2.
  Kopiowany do .repo/local_manifests/ przez ham.yml.
  Remote "github" (fetch="..") rozwiązuje się do https://github.com/ .
-->
<manifest>
  <remote name="gitlab" fetch="https://gitlab.com/" />

  <!-- urządzenie: drzewa LineageOS + 27 commitów Tomoms jako patche (patches/device_motorola_*, docs/przeglad-tomoms.md);
       jądro: fork jądra Tomoms z KernelSU-Next, przy każdym buildzie scalany z LineageOS lineage-23.2 (krok w ham.yml) -->
  <project path="device/motorola/rhode"         name="LineageOS/android_device_motorola_rhode"          remote="github" revision="lineage-23.2" />
  <project path="device/motorola/sm6225-common" name="LineageOS/android_device_motorola_sm6225-common"  remote="github" revision="lineage-23.2" />
  <project path="kernel/motorola/sm6225"        name="MikolajQ/android_kernel_motorola_sm6225"       remote="github" revision="16.2-ksun" />
  <project path="hardware/motorola"             name="LineageOS/android_hardware_motorola"          remote="github" revision="lineage-23.2" />
  <project path="hardware/samsung_slsi/nfc"     name="LineageOS/android_hardware_samsung_slsi_nfc"  remote="github" revision="lineage-23.2" />

  <!-- wydajność (jak u Tomoms): nowszy jemalloc (process_madvise, poprawki purge; bionic przełączony na jemalloc
       patchami bionic/build_make/build_soong/system_core) i nowsze Arm Optimized Routines (memcpy/strlen/… w bionic) z yaap -->
  <remove-project name="platform/external/jemalloc_new" />
  <project path="external/jemalloc_new" name="yaap/external_jemalloc_new" remote="github" revision="sixteen" groups="pdk" />
  <remove-project name="platform/external/arm-optimized-routines" />
  <project path="external/arm-optimized-routines" name="yaap/external_arm-optimized-routines" remote="github" revision="sixteen" groups="pdk" />

  <!-- bloby: radio/* na git-lfs, stąd flaga git-lfs przy repo init -->
  <project path="vendor/motorola/rhode"         name="TheMuppets/proprietary_vendor_motorola_rhode"          remote="github" revision="lineage-23.2" />
  <project path="vendor/motorola/sm6225-common" name="TheMuppets/proprietary_vendor_motorola_sm6225-common"  remote="github" revision="lineage-23.2" />

  <!-- własny vendor/extra: OTA, additional_repos.xml, manager KSU-Next, gapps-extras -->
  <project path="vendor/extra"                  name="MikolajQ/android_vendor_extra"                remote="github" revision="rhode" />

  <!-- GApps: MindTheGapps prosto z GitLaba (GmsCore/Velvet na LFS); cięcia listy pakietów -> patches/vendor_gapps -->
  <project path="vendor/gapps"                  name="MindTheGapps/vendor_gapps"                    remote="gitlab" revision="baklava" clone-depth="1" />

  <!-- Klient F-Droid: Droid-ify (scripts/fetch-droidify.sh) zamiast oficjalnego F-Droida (decyzja 21.09) -->

  <!-- WebView: prebuilt oficjalny LineageOS (moduł "webview", android_app_import, default_dev_cert).
       Do 22.09 był tu remove-project + Cromite (scripts/fetch-webview.sh): Cromite wymusza patchem
       Enable-network-isolation-features.patch cechę kPartitionConnectionsByNetworkIsolationKey globalnie,
       a AwPreconnector WebView zawsze woła z pustym NetworkAnonymizationKey -> CHECK() w
       PreconnectManagerImpl pada -> SIGTRAP w KAŻDEJ apce wołającej androidx.webkit Profile.preconnect()
       (m.in. Google Mobile Ads SDK; złapane na Meteo ICM). Zgłoszone: github.com/uazo/cromite/issues/3085.
       Te projekty są domyślnie w manifeście LineageOS (snippets/lineage.xml) - nic tu nie trzeba dopisywać,
       wystarczy ich nie usuwać. -->
</manifest>
