# Wspólne dla sign.sh i upload.sh: które obrazy idą do release'u obok zipa.
# RELEASE_IMAGES — z podpisanego target-files (IMAGES/), bo zawierają otacerts/podpisy zgodne z zipem;
# EXTRA_IMAGES — z $OUT (poza IMAGES/ target-files, bez otacerts). Zmieniać razem z urządzeniem.
DEVICE=rhode
RELEASE_IMAGES="boot dtbo vendor_boot"
EXTRA_IMAGES=""
