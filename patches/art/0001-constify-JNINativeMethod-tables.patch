+#include <jni.h>
+
+namespace art {
+namespace Test988MethodTrace {
+
+extern "C" JNIEXPORT jint JNICALL Java_art_Test988_nativeFibonacci(JNIEnv* env, jclass, jint n) {
+  if (n < 0) {
+    env->ThrowNew(env->FindClass("java/lang/Error"), "bad argument");
+    return -1;
+  } else if (n == 0) {
+    return 0;
+  }
+  jint x = 1;
+  jint y = 1;
+  for (jint i = 3; i <= n; i++) {
+    jint z = x + y;
+    x = y;
+    y = z;
+  }
+  return y;
+}
+
+}  // namespace Test988MethodTrace
+}  // namespace art
