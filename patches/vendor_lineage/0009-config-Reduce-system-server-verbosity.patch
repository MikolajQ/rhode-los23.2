 config/common.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/config/common.mk b/config/common.mk
index 705002b..e179ac9 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -155,6 +155,9 @@ TARGET_VNDK_USE_CORE_VARIANT := true
 # Disable dexpreopt minidebuginfo
