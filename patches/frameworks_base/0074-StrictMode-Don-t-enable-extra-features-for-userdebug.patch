From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sultan Alsawaf <sultan@kerneltoast.com>
Date: Sat, 3 Apr 2021 16:43:42 -0700
Subject: [PATCH 074/226] StrictMode: Don't enable extra features for userdebug
 builds

On userdebug builds, StrictMode becomes more invasive and can produce
screen flashes when violations are detected. Let's treat userdebug
builds the same as user builds and skip the extra StrictMode features
for userdebug.

Change-Id: Idd9443ac1f5c1db5071e706e013a676c2f179db4
Signed-off-by: Joey Huab <joey@evolution-x.org>
Signed-off-by: Dmitrii <bankersenator@gmail.com>
---
 core/java/android/os/StrictMode.java | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/core/java/android/os/StrictMode.java b/core/java/android/os/StrictMode.java
index 12928596ef..10d75fdc91 100644
--- a/core/java/android/os/StrictMode.java
+++ b/core/java/android/os/StrictMode.java
@@ -1533,12 +1533,8 @@ public final class StrictMode {
             if (isBundledSystemApp(ai)) {
                 builder.detectAll();
                 builder.penaltyDropBox();
-                if (SystemProperties.getBoolean(VISUAL_PROPERTY, false)) {
-                    builder.penaltyFlashScreen();
-                }
-                if (Build.IS_ENG) {
-                    builder.penaltyLog();
-                }
+                builder.penaltyLog();
+                builder.penaltyFlashScreen();
             }
         }
 
