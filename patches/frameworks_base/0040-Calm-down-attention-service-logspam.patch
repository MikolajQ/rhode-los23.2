Subject: [PATCH 040/226] Calm down attention service logspam

Change-Id: Ie5f04a7a875d918db9b09f5aa1ed0b0592a1d48c
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 .../com/android/server/attention/AttentionManagerService.java   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/attention/AttentionManagerService.java b/services/core/java/com/android/server/attention/AttentionManagerService.java
index 5edbaa9396..195070e7c6 100644
--- a/services/core/java/com/android/server/attention/AttentionManagerService.java
+++ b/services/core/java/com/android/server/attention/AttentionManagerService.java
@@ -472,7 +472,7 @@ public class AttentionManagerService extends SystemService {
 
         final ResolveInfo resolveInfo = context.getPackageManager().resolveService(intent, flags);
         if (resolveInfo == null || resolveInfo.serviceInfo == null) {
-            Slog.wtf(LOG_TAG, String.format("Service %s not found in package %s",
+            Slog.v(LOG_TAG, String.format("Service %s not found in package %s",
                     AttentionService.SERVICE_INTERFACE, serviceConfigPackage
             ));
             return null;
