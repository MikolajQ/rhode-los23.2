From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NurKeinNeid <nurkeinneid@derpfest.org>
Date: Sun, 18 Jan 2026 19:25:50 +0100
Subject: [PATCH 202/226] SystemUI: Change log level for multiple blur values
 emitted warning to debug

Signed-off-by: NurKeinNeid <nurkeinneid@derpfest.org>
---
 .../src/com/android/systemui/window/ui/WindowRootViewBinder.kt  | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/window/ui/WindowRootViewBinder.kt b/packages/SystemUI/src/com/android/systemui/window/ui/WindowRootViewBinder.kt
index a0867e3220..ea0ca8edff 100644
--- a/packages/SystemUI/src/com/android/systemui/window/ui/WindowRootViewBinder.kt
+++ b/packages/SystemUI/src/com/android/systemui/window/ui/WindowRootViewBinder.kt
@@ -114,7 +114,7 @@ object WindowRootViewBinder {
                                         lastScheduledBlurRadius != newBlurRadius ||
                                             lastScheduledBlurScale != newBlurScale
                                     ) {
-                                        Log.w(TAG, "Multiple blur values emitted in the same frame")
+                                        Log.d(TAG, "Multiple blur values emitted in the same frame")
                                     }
                                     lastScheduledBlurRadius = newBlurRadius
                                     lastScheduledBlurScale = newBlurScale
