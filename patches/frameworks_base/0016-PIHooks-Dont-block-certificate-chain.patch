From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vivekachooz <vivekachooz@gmail.com>
Date: Sat, 10 Jan 2026 22:34:47 +0530
Subject: [PATCH 16/31] PIHooks: Dont block certificate chain

Change-Id: Ideb6ba789fa5a2da323f1c495d9ea1a52021d65c
---
 core/java/com/android/internal/util/PropImitationHooks.java | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/core/java/com/android/internal/util/PropImitationHooks.java b/core/java/com/android/internal/util/PropImitationHooks.java
index e96a30833d..83371b9d5c 100644
--- a/core/java/com/android/internal/util/PropImitationHooks.java
+++ b/core/java/com/android/internal/util/PropImitationHooks.java
@@ -243,14 +243,14 @@ public class PropImitationHooks {
 
     public static void onEngineGetCertificateChain() {
         if (sDisableKeyAttestationBlock) {
-            dlog("Key attestation blocking is disabled by user");
+            dlog("Key attestation blocking disabled");
             return;
         }
 
         // Check stack for SafetyNet or Play Integrity
         if (isCallerSafetyNet() || sIsFinsky) {
-            dlog("Blocked key attestation sIsGms=" + sIsGms + " sIsFinsky=" + sIsFinsky);
-            throw new UnsupportedOperationException();
+            dlog("Allowing certificate chain for Integrity/SafetyNet");
+            return;
         }
     }
 
