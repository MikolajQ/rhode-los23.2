From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: liamsmith827 <liamsmith827@proton.me>
Date: Sun, 15 Feb 2026 21:31:06 +0000
Subject: [PATCH 3/3] stop dropping router advertisements received on VPN
 interface

---
 server/MulticastFirewallController.cpp     | 5 +++++
 server/MulticastFirewallControllerTest.cpp | 1 +
 2 files changed, 6 insertions(+)

diff --git a/server/MulticastFirewallController.cpp b/server/MulticastFirewallController.cpp
index 60c26ce..408796e 100644
--- a/server/MulticastFirewallController.cpp
+++ b/server/MulticastFirewallController.cpp
@@ -87,6 +87,11 @@ int MulticastFirewallController::flushRules() {
                          MULTICAST_RANGE_IPV4),
             StringPrintf("-4 -A mfw_OUTPUT -o %s -p %d -j DROP", VPN_INTERFACE_NAME,
                          IGMP_PROTOCOL_NUMBER),
+            // Some configurations rely on inbound router advertisements. As the original author
+            // of this firewall noted, this will increase the side channel surface. Stopping all
+            // side channels within the current Android environment is not feasible.
+            StringPrintf("-6 -A mfw_INPUT -i %s -p icmpv6 --icmpv6-type router-advertisement "
+                         "-j RETURN", VPN_INTERFACE_NAME),
             StringPrintf("-6 -A mfw_INPUT -i %s -d %s -j DROP", VPN_INTERFACE_NAME,
                          MULTICAST_RANGE_IPV6),
             StringPrintf("-6 -A mfw_INPUT -i %s -p icmpv6 --icmpv6-type %d -j DROP",
diff --git a/server/MulticastFirewallControllerTest.cpp b/server/MulticastFirewallControllerTest.cpp
index c87ac98..d5210ab 100644
--- a/server/MulticastFirewallControllerTest.cpp
+++ b/server/MulticastFirewallControllerTest.cpp
@@ -30,6 +30,7 @@ TEST_F(MulticastFirewallControllerTest, TestFirewall) {
             "-4 -A mfw_FORWARD -p 2 -j DROP\n"
             "-4 -A mfw_OUTPUT -o tun+ -d 224.0.0.0/4 -j DROP\n"
             "-4 -A mfw_OUTPUT -o tun+ -p 2 -j DROP\n"
+            "-6 -A mfw_INPUT -i tun+ -p icmpv6 --icmpv6-type router-advertisement -j RETURN\n"
             "-6 -A mfw_INPUT -i tun+ -d ff00::/8 -j DROP\n"
             "-6 -A mfw_INPUT -i tun+ -p icmpv6 --icmpv6-type 130 -j DROP\n"
             "-6 -A mfw_INPUT -i tun+ -p icmpv6 --icmpv6-type 131 -j DROP\n"
