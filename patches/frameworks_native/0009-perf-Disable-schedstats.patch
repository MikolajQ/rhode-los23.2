From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rmp22 <195054967+rmp22@users.noreply.github.com>
Date: Fri, 14 Feb 2025 11:55:32 +0800
Subject: [PATCH 09/42] perf: Disable schedstats

Change-Id: I5d1eef7a493451afc9f75df274ec4aed8e8df87c
Signed-off-by: rmp22 <195054967+rmp22@users.noreply.github.com>
Signed-off-by: Ghosuto <clash.raja10@gmail.com>
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 cmds/atrace/atrace.rc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmds/atrace/atrace.rc b/cmds/atrace/atrace.rc
index 46cd6f3..260700b 100644
--- a/cmds/atrace/atrace.rc
+++ b/cmds/atrace/atrace.rc
@@ -7,7 +7,7 @@ on late-init
     chmod 0222 /sys/kernel/tracing/trace_marker
 
 # Scheduler tracepoints require schedstats=enable
-    write /proc/sys/kernel/sched_schedstats 1
+    write /proc/sys/kernel/sched_schedstats 0
 
 # Grant unix world read/write permissions to kernel tracepoints.
 # Access control to these files is now entirely in selinux policy.
