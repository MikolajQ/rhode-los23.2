From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simao Gomes Viana <xdevs23@outlook.com>
Date: Sat, 21 Dec 2019 12:09:48 +0100
Subject: [PATCH 06/42] Add dalvik-heap device configs for 8/12/16 GiB devices

Change-Id: Icdfd3512a79d9935d3fdb611c96dc8fd91a5e1c5
Signed-off-by: DennySPB <dennyspb@gmail.com>
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
Signed-off-by: Dmitrii <bankersenator@gmail.com>
---
 build/phone-xhdpi-12288-dalvik-heap.mk | 26 ++++++++++++++++++++++++++
 build/phone-xhdpi-16384-dalvik-heap.mk | 26 ++++++++++++++++++++++++++
 build/phone-xhdpi-8192-dalvik-heap.mk  | 26 ++++++++++++++++++++++++++
 3 files changed, 78 insertions(+)
 create mode 100644 build/phone-xhdpi-12288-dalvik-heap.mk
 create mode 100644 build/phone-xhdpi-16384-dalvik-heap.mk
 create mode 100644 build/phone-xhdpi-8192-dalvik-heap.mk

diff --git a/build/phone-xhdpi-12288-dalvik-heap.mk b/build/phone-xhdpi-12288-dalvik-heap.mk
new file mode 100644
index 0000000..1b0eb03
--- /dev/null
+++ b/build/phone-xhdpi-12288-dalvik-heap.mk
@@ -0,0 +1,26 @@
+#
+# Copyright 2019 The Android Open Source Project
+# Copyright 2019 The halogenOS Project
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
