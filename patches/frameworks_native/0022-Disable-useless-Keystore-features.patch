From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chiteroman <98092901+chiteroman@users.noreply.github.com>
Date: Sun, 16 Jun 2024 13:57:34 +0200
Subject: [PATCH 22/42] Disable useless Keystore features

Change-Id: I28a2e93d0718e5950948b87a6c6abf4341753552
---
 data/etc/android.hardware.device_unique_attestation.xml | 1 -
 data/etc/android.hardware.keystore.app_attest_key.xml   | 1 -
 data/etc/android.hardware.keystore.limited_use_key.xml  | 1 -
 data/etc/android.hardware.keystore.single_use_key.xml   | 1 -
 data/etc/android.hardware.strongbox_keystore.xml        | 1 -
 data/etc/android.software.device_id_attestation.xml     | 1 -
 6 files changed, 6 deletions(-)

diff --git a/data/etc/android.hardware.device_unique_attestation.xml b/data/etc/android.hardware.device_unique_attestation.xml
index 309be7a..aaa3a46 100644
--- a/data/etc/android.hardware.device_unique_attestation.xml
+++ b/data/etc/android.hardware.device_unique_attestation.xml
@@ -16,5 +16,4 @@
 
 <!-- Feature for devices with Keymaster that support unique attestation. -->
 <permissions>
-    <feature name="android.hardware.device_unique_attestation" />
 </permissions>
diff --git a/data/etc/android.hardware.keystore.app_attest_key.xml b/data/etc/android.hardware.keystore.app_attest_key.xml
index 8adc439..bfaf1f0 100644
--- a/data/etc/android.hardware.keystore.app_attest_key.xml
+++ b/data/etc/android.hardware.keystore.app_attest_key.xml
@@ -16,5 +16,4 @@
 
 <!-- Feature for devices that support app attestation keys (i.e. KeyMint 1.0). -->
 <permissions>
-    <feature name="android.hardware.keystore.app_attest_key" />
 </permissions>
diff --git a/data/etc/android.hardware.keystore.limited_use_key.xml b/data/etc/android.hardware.keystore.limited_use_key.xml
index 5217086..70b9bbc 100644
--- a/data/etc/android.hardware.keystore.limited_use_key.xml
+++ b/data/etc/android.hardware.keystore.limited_use_key.xml
@@ -17,5 +17,4 @@
 <!-- Feature for devices with KeyMint that can enforce limited use key
      in hardware with any max usage count (including count equals to 1). -->
 <permissions>
-    <feature name="android.hardware.keystore.limited_use_key" />
 </permissions>
\ No newline at end of file
diff --git a/data/etc/android.hardware.keystore.single_use_key.xml b/data/etc/android.hardware.keystore.single_use_key.xml
index 40e80aa..c8b23b3 100644
--- a/data/etc/android.hardware.keystore.single_use_key.xml
+++ b/data/etc/android.hardware.keystore.single_use_key.xml
@@ -17,5 +17,4 @@
 <!-- Feature for devices with KeyMint that only can enforce limited use key
      in hardware with max usage count equals to 1. -->
 <permissions>
-    <feature name="android.hardware.keystore.single_use_key" />
 </permissions>
\ No newline at end of file
diff --git a/data/etc/android.hardware.strongbox_keystore.xml b/data/etc/android.hardware.strongbox_keystore.xml
index 2a0ec37..11a0e27 100644
--- a/data/etc/android.hardware.strongbox_keystore.xml
+++ b/data/etc/android.hardware.strongbox_keystore.xml
@@ -16,5 +16,4 @@
 
 <!-- Feature for devices with Keymaster in StrongBox. -->
 <permissions>
-    <feature name="android.hardware.strongbox_keystore" />
 </permissions>
diff --git a/data/etc/android.software.device_id_attestation.xml b/data/etc/android.software.device_id_attestation.xml
index 4e637ca..4792fd2 100644
--- a/data/etc/android.software.device_id_attestation.xml
+++ b/data/etc/android.software.device_id_attestation.xml
@@ -16,5 +16,4 @@
 
 <!-- Feature for devices with Keymaster that support Device ID attestation. -->
 <permissions>
-    <feature name="android.software.device_id_attestation" />
 </permissions>
